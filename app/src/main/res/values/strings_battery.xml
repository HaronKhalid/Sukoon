    <string name="battery_history_title">Level history</string>
    <string name="battery_history_note">Samples are recorded only while this screen is open, stored on this device, and capped at %1$d.</string>
    <string name="battery_history_empty">Not enough samples yet. Keep this screen open or come back later.</string>
    <string name="battery_history_count">%1$d samples</string>
    <string name="battery_history_clear">Clear data</string>

    <string name="battery_usage_title">Screen time per app</string>
    <string name="battery_usage_why">Android only shares how long each app was on screen through Usage access. This is screen time, not battery use: an app on screen for a long time can use little power, and background power use is not shown.</string>
    <string name="battery_usage_disabled">Usage access is off, so this section is disabled. The rest of the launcher works normally.</string>
    <string name="battery_usage_grant">Review and grant usage access</string>
    <string name="battery_usage_dialog_title">Usage access</string>
    <string name="battery_usage_dialog_body">Android will open its Usage access screen. Enable it for this launcher only if you want per-app screen time here. Data stays on your device and you can revoke access at any time.</string>
    <string name="battery_usage_continue">Continue</string>
    <string name="battery_usage_cancel">Cancel</string>
    <string name="battery_usage_last24">Screen time, last 24 hours (approximate)</string>
    <string name="battery_usage_none">No app screen time recorded.</string>

    <string name="battery_profile_title">Power profile</string>
    <string name="battery_profile_note">Launcher-level preference only. It never changes Android system settings.</string>
    <string name="battery_profile_balanced">Balanced</string>
    <string name="battery_profile_balanced_desc">Normal launcher behaviour. No background polling.</string>
    <string name="battery_profile_saver">Power Saver</string>
    <string name="battery_profile_saver_desc">Suggested: use a static wallpaper and avoid auto-refreshing widgets. Use Android Battery Saver below if you want system-wide effects.</string>
    <string name="battery_profile_extreme">Extreme Focus</string>
    <string name="battery_profile_extreme_desc">Suggested: dark theme, only essential apps on home, no animated or online wallpaper.</string>
    <string name="battery_open_saver_settings">Open Android Battery Saver settings</string>

    <string name="battery_recs_title">Suggestions</string>
    <string name="battery_rec_warm">The battery is warm. Consider closing demanding apps or removing the case.</string>
    <string name="battery_rec_hot">The battery is hot. Stop charging and heavy use until it cools down.</string>
    <string name="battery_rec_health">Android reports a battery health flag other than Good.</string>
    <string name="battery_rec_low_saver">Battery is below 20 percent and Battery Saver is off. You can turn it on in Android settings.</string>
</resources>
